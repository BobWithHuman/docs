---
import { Icon } from '@astrojs/starlight/components';

interface Props {
  href: string;
  title: string;
  button: string;
}
const { href, title, button } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="cta not-content">
  <Icon name="rocket" size="2.5rem" class="rocket" />
  <div class="body">
    <span class="eyebrow">Ready to get started?</span>
    <span class="title">{title}</span>
    <span class="desc"><slot /></span>
  </div>
  <a href={base + href}>{button} →</a>
</div>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
    margin-top: 2rem;
    padding: 1rem 1.5rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    background: var(--sl-color-accent-low);
  }
  .cta :global(.rocket) {
    color: var(--sl-color-accent);
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .eyebrow {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .title {
    font-size: var(--sl-text-lg);
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .desc {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  a {
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    background: var(--sl-color-accent-high);
    color: var(--sl-color-accent-low);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
  }
</style>
