---
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  icon: 'book' | 'chart' | 'nodes' | 'database';
}
const { href, eyebrow, title, icon } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const paths = {
  book: 'M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2zM22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z',
  chart: 'M5 20v-4M10 20v-8M15 20V8M20 20V4',
  nodes: 'M12 9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM6 20a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM18 20a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM12 9v3M12 12l-4.5 3.5M12 12l4.5 3.5',
  database: 'M4 5c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zM4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
};
---

<a class="card not-content" href={base + href}>
  <span class="icon">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[icon]} /></svg>
  </span>
  <span class="body">
    <span class="eyebrow">{eyebrow}</span>
    <span class="title">{title}</span>
    <span class="desc"><slot /></span>
  </span>
  <span class="arrow" aria-hidden="true">→</span>
</a>

<style>
  .card {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    margin-top: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .card:hover {
    border-color: var(--sl-color-accent);
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 0.75rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }
  .icon svg {
    width: 2.25rem;
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .eyebrow {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .title {
    font-size: var(--sl-text-xl);
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .desc {
    color: var(--sl-color-gray-2);
  }
  .arrow {
    font-size: 1.5rem;
    color: var(--sl-color-white);
  }
</style>
