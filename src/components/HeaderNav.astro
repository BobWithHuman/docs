---
import { Icon } from '@astrojs/starlight/components';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { label: 'Docs', href: `${base}/` },
  { label: 'Integrations', href: `${base}/integrations/agent/openclaw/` },
  { label: 'Security', href: `${base}/security/threat-model/` },
];
---

<nav class="header-nav">
  {links.map((l) => <a href={l.href}>{l.label}</a>)}
  <a href="https://github.com/BobWithHuman/docs"><Icon name="github" size="1.25rem" />GitHub</a>
</nav>

<style>
  .header-nav {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }
  a {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  a:hover {
    color: var(--sl-color-accent);
  }
</style>
